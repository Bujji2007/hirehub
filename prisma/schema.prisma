datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model Job {
  id          String      @id @default(cuid())
  title       String
  description String
  candidates  Candidate[]
  createdAt   DateTime    @default(now())
}

model Candidate {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  skills        String
  experienceYrs Int      @default(0)
  stage         String   @default("APPLIED")
  atsScore      Int?
  aiSummary     String?
  jobId         String
  job           Job      @relation(fields: [jobId], references: [id])
  createdAt     DateTime @default(now())
}
